DOMAIN=<domain>
DATABASE_NAME=igsn
DATABASE_USER=igsn
DATABASE_PASSWORD=change-me

SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=
SMTP_FROM_NAME_ADMIN=

SAMPLE_SEARCH_FUZZY_THRESHOLD=0.8

UPLOAD_LIMIT=5

SAMPLE_EDIT_LOCK_TTL_MINUTES=15

OIDC_ALLOWED_IDENTITY_PROVIDERS=satosa,orcid

# No DATACITE_API_HOST disables registration: samples publish without a DOI.
# With one, KEY and PREFIX are required or the api stops at boot, and publishing answers 502 when DataCite refuses the record.
DATACITE_API_HOST=https://api.test.datacite.org
DATACITE_API_KEY=
DATACITE_DOI_PREFIX=10.5072
