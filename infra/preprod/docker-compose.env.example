# Copy to docker-compose.env, fill in, then copy that file to the preprod host's
# home directory before running `make preprod-deploy`. It holds the Postgres
# password, so the real docker-compose.env is gitignored.
#
# DOMAIN is the Cloudflare zone whose {igsn.,igsn-admin.,igsn-api.} A records point
# at the host EIP (single-level subdomains, covered by the *.DOMAIN cert). The
# DATABASE_* values seed the Postgres container on first boot; pick a strong
# password.

DOMAIN=<domain>
DATABASE_NAME=igsn
DATABASE_USER=igsn
DATABASE_PASSWORD=change-me

# Outbound mail: SMTP endpoint and credentials of a transactional-mail
# provider (Brevo, Resend, Postmark...), from its dashboard after verifying
# the sending domain there. SMTP_PORT is optional (defaults to 587, STARTTLS).
# The api reads them at boot and refuses to start without a host.
# See docs/preprod-setup.md.
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
# Optional sender display names, what a recipient reads instead of the sender
# address; default to IGSN for user mail and No-reply for admin mail.
SMTP_FROM_NAME=
SMTP_FROM_NAME_ADMIN=

# Optional. Minimum word_similarity (0 to 1) for the sample search's typo
# tolerance; defaults to 0.8. Lower catches more misspellings but admits more
# near-miss geological terms.
SAMPLE_SEARCH_FUZZY_THRESHOLD=0.8

# Rate limiting, set on the api service. RATE_LIMIT_ENABLED is optional (the
# api ships enabled); public routes count per IP, admin routes per JWT sub,
# each at a fixed budget (packages/api/src/rate-limit/config.ts).
# TRUST_PROXY_HEADERS is required, and set in docker-compose.yml.

# Optional. How many files a sample may carry; defaults to 5. The api reads
# this file's value, but the admin bundle gets it from deploy.sh expanding
# ${UPLOAD_LIMIT:-5} in the deploying shell, not from this file. Export the
# same value in that shell so the two agree, e.g.:
#   UPLOAD_LIMIT=10 ./deploy.sh ...
UPLOAD_LIMIT=5

# Optional. How many whole minutes a sample edit lock survives without a
# heartbeat; defaults to 15. The admin page renews every 5 minutes, so a value
# under that leaves an editor briefly unlocked between heartbeats. Garbage or
# a value below 1 falls back to the default (ADR 0024).
SAMPLE_EDIT_LOCK_TTL_MINUTES=15

# Optional. Comma-separated Keycloak broker aliases whose users may sign in;
# defaults to satosa,orcid, which is correct in every environment. It exists so
# an alias change at the Gaia Data SSO is a redeploy value, not a code fix (the
# same reason OIDC_AUDIENCE is opt-in, ADR 0006 amendment).
OIDC_ALLOWED_IDENTITY_PROVIDERS=satosa,orcid
