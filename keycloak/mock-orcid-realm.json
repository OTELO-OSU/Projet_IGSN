{
  "realm": "mock-orcid",
  "enabled": true,
  "sslRequired": "none",
  "displayName": "Mock ORCID (dev only)",
  "internationalizationEnabled": true,
  "supportedLocales": ["en"],
  "defaultLocale": "en",
  "localizationTexts": {
    "en": {
      "usernameOrEmail": "ORCID iD",
      "username": "ORCID iD"
    }
  },
  "clients": [
    {
      "clientId": "igsn-broker",
      "name": "IGSN Keycloak broker",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "mock-orcid-secret",
      "clientAuthenticatorType": "client-secret",
      "standardFlowEnabled": true,
      "redirectUris": [
        "${ORCID_BROKER_REDIRECT_URI:http://localhost:8080/realms/igsn/broker/orcid/endpoint}",
        "${ADMIN_REDIRECT_URI:http://localhost:3000/admin/*}"
      ],
      "attributes": {
        "post.logout.redirect.uris": "${ORCID_BROKER_REDIRECT_URI:http://localhost:8080/realms/igsn/broker/orcid/endpoint}/logout_response"
      }
    }
  ],
