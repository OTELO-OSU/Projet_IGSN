{
  "mcpServers": {
    "playwright": {
      "command": "pnpm",
      "args": [
        "dlx",
        "@playwright/mcp@catalog:",
        "--allowed-origins=https://marmelab.com;http://localhost:3000"
      ]
    },
    "memnos": {
      "command": "node",
      "args": ["node_modules/memnos/dist/src/server.js"],
      "env": { "MEMNOS_BUNDLE_PATH": "./knowledge" }
    }
  }
}
