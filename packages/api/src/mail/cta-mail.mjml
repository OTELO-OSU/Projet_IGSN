<mjml>
  <mj-head>
    <mj-title>__TITLE__</mj-title>
    <mj-attributes>
      <mj-all font-family="Helvetica, Arial, sans-serif" />
      <mj-text font-size="14px" color="#1f2937" line-height="22px" />
    </mj-attributes>
  </mj-head>
  <mj-body background-color="#f3f4f6">
    <mj-section background-color="#ffffff" padding="24px">
      <mj-column>
        <mj-text font-size="18px" font-weight="bold">__TITLE__</mj-text>
        <mj-text>__GREETING__</mj-text>
        <mj-text>__BODY__</mj-text>
        __QUOTE__
        <mj-button
          href="__URL__"
          background-color="#1d4ed8"
          color="#ffffff"
          padding="24px 0 0"
        >
          __CTA__
        </mj-button>
        <mj-text font-size="12px" color="#6b7280" padding="16px 0 0">
          __LINK_FALLBACK__<br /><a
            href="__URL__"
            style="color: #1d4ed8; word-break: break-all"
            >__URL__</a
          >
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
